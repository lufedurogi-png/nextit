APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# API base (debe incluir puerto en local, ej. :8000)
APP_URL=http://localhost:8000
# Zona horaria de negocio (fecha del pedido, jobs, Carbon::now()). México: America/Mexico_City
APP_TIMEZONE=America/Mexico_City

# URL del frontend (Next.js) para redirecciones (ej. /admin/login → frontend/admin-login)
FRONTEND_URL=http://localhost:3000

# Folios de pedido (6 dígitos) y cotizaciones en PDF del servidor: primer número ≥ este valor
DOCUMENTO_NUMERO_INICIAL=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=optional
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
# 43200 = 30 días. Sesión no expira hasta cierre manual.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: con MAIL_MAILER=log no se envía a buzones; solo se registra en storage/logs.
# Producción / prueba real: copia y rellena (Gmail suele exigir "Contraseña de aplicaciones").
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ejemplo Gmail (descomenta y ajusta):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_cuenta@gmail.com
# MAIL_PASSWORD=contraseña_de_aplicacion_sin_espacios
# MAIL_FROM_ADDRESS="tu_cuenta@gmail.com"
# Si el puerto 587 no conecta (firewall), prueba:
# MAIL_PORT=465
# MAIL_SCHEME=smtps

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API CVA (catálogo de productos)
CVA_BASE_URL=https://apicvaservices.grupocva.com/api/v2
CVA_USER=
CVA_PASSWORD=
CVA_PORCENTAJE_UTILIDAD=0
CVA_MONEDA_PESOS=true
# Cotización de flete CVA (POST JSON: paqueteria, cp, cp_sucursal, productos). URL oficial en documentación CVA «Cotizar flete».
# Alternativa al nombre CVA_FLETE_URL (mismo valor): CVA_API_URL_FLETE=... (como en NEXT.IT.txt / proyecto Pruebas).
CVA_FLETE_URL=https://www.grupocva.com/api/paqueteria_service/
# CVA_API_URL_FLETE=

# Entrega estimada mostrada al cliente (días naturales desde hoy)
ENVIO_DIAS_ENTREGA_MIN=3
ENVIO_DIAS_ENTREGA_MAX=7

# API tipo de cambio USD → MXN (ExchangeRate-API: https://www.exchangerate-api.com/)
EXCHANGERATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGERATE_API_KEY=

# PayPal (sandbox: PAYPAL_MODE=sandbox; producción: live). Credenciales en developer.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Mercado Pago (México: developers.mercadopago.com.mx — credenciales de prueba o producción)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional (HTTPS público): URL completa del webhook para preferencias en local, ej. https://xxxx.ngrok-free.app/api/v1/mercadopago/webhook
MERCADOPAGO_NOTIFICATION_URL=